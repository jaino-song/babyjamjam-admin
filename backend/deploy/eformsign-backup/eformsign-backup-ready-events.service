[Unit]
Description=Subscribe to eformsign PDF-ready archive updates

[Service]
Type=simple
ExecStart=/usr/bin/env node %h/eformsign-backup/backup.mjs --settings %h/.config/eformsign-backup/settings.json --raster --ready-wake
Restart=on-failure
RestartSec=30s
TimeoutStopSec=10s
KillMode=control-group

[Install]
WantedBy=default.target
