[Unit]
Description=BabyJamJam document backup worker

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/bjj-backup/app/backend
Environment=NODE_PATH=.
UMask=0077
NoNewPrivileges=true
ExecStart=/usr/bin/flock -n -F -E 75 %h/.local/state/bjj-backup/control/worker.lock /usr/bin/node -r ts-node/register/transpile-only scripts/eformsign-backup-worker.ts process-pending --config %h/.config/bjj-backup/worker.json --max-jobs 1
SuccessExitStatus=75
